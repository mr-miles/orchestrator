{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The findings selected to work on and those dropped (select/selection.json).",
  "type": "object",
  "required": ["selected", "dropped"],
  "additionalProperties": false,
  "properties": {
    "selected": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "reason", "scope", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^F-[0-9]+$"},
          "reason": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^git:[^@\\s]+@[0-9a-f]{7,40}$"}
          }
        }
      }
    },
    "dropped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "reason"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^F-[0-9]+$"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
