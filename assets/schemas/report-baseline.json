{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Report data for the baseline verifier.",
  "type": "object",
  "required": [
    "results"
  ],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "exit_code"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "exit_code": {
            "type": "integer"
          },
          "output": {
            "type": "string",
            "maxLength": 4000
          }
        }
      },
      "maxItems": 100
    }
  },
  "additionalProperties": false
}
