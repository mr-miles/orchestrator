{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One review verdict per design finding (findings-review/findings-review.json).",
  "type": "object",
  "required": ["reviews"],
  "additionalProperties": false,
  "properties": {
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["finding", "verdict", "severity", "note"],
        "additionalProperties": false,
        "properties": {
          "finding": {"type": "string", "pattern": "^F-[0-9]+$"},
          "verdict": {"enum": ["valid", "invalid", "unclear"]},
          "severity": {"enum": ["high", "medium", "low"]},
          "note": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
