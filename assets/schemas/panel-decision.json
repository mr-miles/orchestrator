{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A panel's pass (G-RV1): every judge that sat passed the candidate in the cycle, each citing its review document.",
  "type": "object",
  "required": [
    "sha",
    "cycle"
  ],
  "properties": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "cycle": {
      "type": "integer",
      "minimum": 1
    },
    "judges": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
