{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Oracle: protected acceptance tests, commands, criteria and verification surfaces (plan/oracle.json).",
  "type": "object",
  "required": [
    "acceptance_tests",
    "acceptance_commands",
    "integration_commands",
    "criteria"
  ],
  "properties": {
    "acceptance_tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))(?!.*\\\\)\\S.*$"
      },
      "uniqueItems": true
    },
    "acceptance_commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "integration_commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "requirement",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]+$"
          },
          "requirement": {
            "type": "string",
            "pattern": "^REQ-[0-9]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "commands",
          "pins"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "description": {
            "type": "string"
          },
          "commands": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "pins": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))(?!.*\\\\)\\S.*$"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
