{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Oracle: protected acceptance tests, commands, criteria and verification surfaces (plan/oracle.json).",
  "type": "object",
  "required": [
    "acceptance_tests",
    "acceptance_commands",
    "integration_commands",
    "criteria"
  ],
  "properties": {
    "acceptance_tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))(?!.*\\\\)\\S.*$"
      },
      "uniqueItems": true,
      "maxItems": 200
    },
    "setup_commands": {
      "type": "array",
      "description": "Run first, in order, in every verifier sandbox (dependency installs, builds the tests need); a failure stops verification",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 20
    },
    "acceptance_commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 50
    },
    "integration_commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "maxItems": 50
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "requirement",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]+$"
          },
          "requirement": {
            "type": "string",
            "pattern": "^REQ-[0-9]+$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "tests": {
            "type": "array",
            "description": "acceptance_tests paths that check this criterion (G-P12)",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "uniqueItems": true,
            "maxItems": 20
          },
          "commands": {
            "type": "array",
            "description": "acceptance_commands that check this criterion (G-P12)",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "uniqueItems": true,
            "maxItems": 20
          }
        },
        "additionalProperties": false
      },
      "maxItems": 200
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "commands",
          "pins"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "commands": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "maxItems": 20
          },
          "pins": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))(?!.*\\\\)\\S.*$"
            },
            "maxItems": 50
          }
        },
        "additionalProperties": false
      },
      "maxItems": 20
    },
    "protected_support": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))(?!.*\\\\)\\S.*$"
      },
      "maxItems": 50,
      "uniqueItems": true,
      "description": "Test-runner support files (conftest.py, pytest.ini, fixtures) protected like acceptance tests"
    }
  },
  "additionalProperties": false
}
