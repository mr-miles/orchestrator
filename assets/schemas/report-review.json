{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Report data for reviewer, security and architecture roles.",
  "type": "object",
  "required": [
    "verdict",
    "findings",
    "checked"
  ],
  "properties": {
    "verdict": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      },
      "maxItems": 30
    },
    "checked": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "maxItems": 50
    }
  },
  "additionalProperties": false,
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "confidence",
        "title",
        "fix",
        "attestations"
      ],
      "properties": {
        "severity": {
          "enum": [
            "BLOCKER",
            "WARNING",
            "SUGGESTION"
          ]
        },
        "confidence": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        },
        "dimension": {
          "enum": [
            "correctness",
            "security",
            "clarity",
            "tests",
            "performance",
            "scope",
            "architecture",
            "completeness",
            "assumptions"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "observation": {
          "type": "string",
          "maxLength": 2000
        },
        "impact": {
          "type": "string",
          "maxLength": 2000
        },
        "fix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "attestations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "maxItems": 20
        }
      }
    }
  }
}
