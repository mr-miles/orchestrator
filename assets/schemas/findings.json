{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Design findings, each backed by attested git evidence (design-review inspect/findings.json).",
  "type": "object",
  "required": ["findings"],
  "additionalProperties": false,
  "properties": {
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "evidence", "problem", "direction", "severity", "effort"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^F-[0-9]+$"},
          "title": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^git:[^@\\s]+@[0-9a-f]{7,40}$"}
          },
          "problem": {"type": "string", "minLength": 1},
          "direction": {"type": "string", "minLength": 1},
          "severity": {"enum": ["high", "medium", "low"]},
          "effort": {"enum": ["small", "medium", "large"]}
        }
      }
    }
  }
}
