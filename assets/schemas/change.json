{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Controller change record.",
  "type": "object",
  "required": [
    "id",
    "goal",
    "workspace",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "workspace": {
      "type": "string",
      "minLength": 1,
      "description": "the configured workspace (repository) the change is made in"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "READY",
        "NOT_READY",
        "ABANDONED"
      ]
    },
    "base_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$",
      "description": "set by the workspace step: the base branch's commit the change starts from"
    },
    "tier": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        null
      ]
    }
  }
}
