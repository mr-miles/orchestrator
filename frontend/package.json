{
  "name": "legion-orchestrator-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "types": "cd .. && uv run --quiet python scripts/gen_types.py",
    "dev": "bun run types && bun --bun vite",
    "build": "bun run types && tsc -b && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "format": "bun --bun prettier --write .",
    "format:check": "bun --bun prettier --check .",
    "test": "bun test",
    "check": "bun run types && bun run typecheck && bun run lint && bun run format:check && bun test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
